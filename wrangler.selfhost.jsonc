{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opengrail-selfhost",
  "main": "./build/selfhost-worker.ts",
  // Match the installed project/workerd baseline. Advance only after reviewing
  // APIs and validating the exact upgraded target; no dependency upgrade here.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"binding": "ASSETS", "run_worker_first": false},
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "invocation_logs": false, "head_sampling_rate": 1},
    "traces": {"enabled": true, "head_sampling_rate": 0, "persist": false}
  },
  "vars": {
    "OPENGRAIL_EXTERNAL_ORIGIN": "https://selfhost.opengrail.invalid",
    "OPENGRAIL_OIDC_CLIENT_ID": "",
    "OPENGRAIL_OIDC_METADATA": ""
  },
  "secrets": {"required": ["OPENGRAIL_OIDC_CLIENT_SECRET", "OPENGRAIL_AUTH_EPOCH"]},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opengrail-selfhost-registry",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "./drizzle"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "opengrail-selfhost-auth",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "./selfhost/migrations"
    }
  ]
}
